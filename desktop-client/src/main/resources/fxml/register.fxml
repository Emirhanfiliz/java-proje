<?xml version="1.0" encoding="UTF-8"?>

import javafx.geometry.Insets?>
import javafx.scene.control.Button?>
import javafx.scene.control.Label?>
import javafx.scene.control.PasswordField?>
import javafx.scene.control.TextField?>
import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sporttracker.desktop.controller.RegisterController">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Sport Tracker Kayıt" />
    
    <Label fx:id="errorLabel" textFill="RED" />

    <VBox spacing="5.0">
        <Label text="Kullanıcı Adı" />
        <TextField fx:id="usernameField" promptText="Kullanıcı Adı" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Email" />
        <TextField fx:id="emailField" promptText="Email adresiniz" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Şifre" />
        <PasswordField fx:id="passwordField" promptText="Şifre (En az 6 karakter)" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Şifre Tekrar" />
        <PasswordField fx:id="confirmPasswordField" promptText="Şifre Tekrar" />
    </VBox>

    <Button onAction="#handleRegister" prefWidth="200.0" text="Kayıt Ol" />
    
    <Button onAction="#handleGoToLogin" style="-fx-background-color: transparent; -fx-text-fill: blue; -fx-cursor: hand;" text="Zaten hesabınız var mı? Giriş Yap" />
</VBox>
