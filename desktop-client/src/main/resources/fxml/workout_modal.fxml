<?xml version="1.0" encoding="UTF-8"?>

import javafx.geometry.Insets?>
import javafx.scene.control.Button?>
import javafx.scene.control.Label?>
import javafx.scene.control.TextField?>
import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sporttracker.desktop.controller.WorkoutModalController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Antrenman Bilgileri" />
    
    <Label fx:id="errorLabel" textFill="RED" />

    <VBox spacing="5.0">
        <Label text="Antrenman Adı" />
        <TextField fx:id="nameField" promptText="Örn: Kardiyo" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Süre (Dakika)" />
        <TextField fx:id="durationField" promptText="Örn: 45" />
    </VBox>

    <Button onAction="#handleSave" prefWidth="200.0" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Kaydet" />
    <Button onAction="#handleCancel" prefWidth="200.0" text="İptal" />
</VBox>
